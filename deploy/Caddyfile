# Production reverse proxy (Ship plan step 5). The only service reachable from
# outside: it gets and renews the HTTPS certificate for {$DOMAIN} automatically
# (Let's Encrypt; for DOMAIN=localhost, Caddy's own local CA), and serves the
# UI and the API on one origin, so the browser needs no CORS.

# Caddy writes no access log here, but an error (e.g. the API is down) logs the
# whole request. The filter removes what identifies the visitor from every log
# line. The headers go too: a client's own X-Forwarded-For, X-Real-IP or Referer
# would otherwise be logged as sent. "remote" is on certificate validation lines.
{
	# Bounds on slow clients. Writes are left to Caddy's defaults on purpose: write_idle
	# only limits a stalled write, so answers streaming as server-sent events are fine,
	# and a hard `write` limit would cut a long answer off.
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			read_body_idle 10s
			idle 2m
		}
	}

	log default {
		format filter {
			wrap json
			fields {
				remote delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
			}
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	# The API, under /api (the prefix is stripped: the app knows /chat, /sources/...).
	handle_path /api/* {
		# First line of defence; the app has the same limit (MAX_BODY_BYTES), for
		# the paths with no Caddy. KiB, not KB: Caddy reads 64KB as 64,000 bytes.
		request_body {
			max_size 64KiB
		}
		reverse_proxy api:8000 {
			# Answers stream as server-sent events: pass each piece on at once.
			flush_interval -1
		}
	}

	# Everything else is the built UI, served by the frontend container.
	handle {
		reverse_proxy frontend:80
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Which sources the page may load: nothing by default, then only what the
		# built app uses. Enforced once report-only showed zero violations (the
		# rule is in CLAUDE.md). /api/docs loads from a CDN, so it stops working
		# here until B19 turns it off.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}
