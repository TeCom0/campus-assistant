# Postgres (used by docker-compose.yml)
POSTGRES_USER=campus_assistant
POSTGRES_PASSWORD=changeme
POSTGRES_DB=campus_assistant
POSTGRES_PORT=15432
# Not 5432/5433 (native Postgres installs on this machine have bound both)
# and not a high port like 55432 either: Windows/Hyper-V dynamically
# reserves chunks of the 49152-65535 ephemeral range for WSL2 NAT, and 55432
# landed in one of those reserved ranges after a reboot, breaking a port
# that had worked fine for days. 15432 sits below that whole range, so it's
# structurally immune to this class of problem, not just dodging today's
# specific exclusions.

# LLM providers (get keys at console.groq.com and ai.google.dev)
GROQ_API_KEY=your-groq-key-here
GEMINI_API_KEY=your-gemini-key-here
