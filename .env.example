# Postgres (used by docker-compose.yml)
POSTGRES_USER=campus_assistant
POSTGRES_PASSWORD=changeme
POSTGRES_DB=campus_assistant
POSTGRES_PORT=15432
# Not 5432/5433 (native Postgres installs on this machine have bound both)
# and not a high port like 55432 either: Windows/Hyper-V dynamically
# reserves chunks of the 49152-65535 ephemeral range for WSL2 NAT, and 55432
# landed in one of those reserved ranges after a reboot, breaking a port
# that had worked fine for days. 15432 sits below that whole range, so it's
# structurally immune to this class of problem, not just dodging today's
# specific exclusions.

# LLM providers (get keys at console.groq.com and ai.google.dev)
GROQ_API_KEY=your-groq-key-here
GEMINI_API_KEY=your-gemini-key-here
# Only for the faithfulness judge (console.mistral.ai); the app doesn't use it
MISTRAL_API_KEY=your-mistral-key-here

# Demo protection (backend/app/limits.py). Defaults shown; all optional.
# DAILY_QUESTION_CAP=30        # questions/day for everyone (Groq free tier: ~40 fit)
# PER_IP_LIMIT=5               # questions per client IP per window
# PER_IP_WINDOW_MINUTES=10
# TRUST_PROXY_HEADERS=true     # ONLY on the server behind Caddy: read X-Forwarded-For
# IP_HASH_SECRET=              # random string; IPs are stored only as an HMAC with it
