# Postgres (used by docker-compose.yml)
POSTGRES_USER=campus_assistant
POSTGRES_PASSWORD=changeme
POSTGRES_DB=campus_assistant
POSTGRES_PORT=55432
# Not 5432 or 5433: this machine has had native Postgres installs bind to
# both of those. 55432 is unlikely to collide with any native Postgres
# default port.

# LLM providers (get keys at console.groq.com and ai.google.dev)
GROQ_API_KEY=your-groq-key-here
GEMINI_API_KEY=your-gemini-key-here
