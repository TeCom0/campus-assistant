# Data (raw/processed documents are gitignored and regenerated by the ingestion scripts;
# data/sources.md is still tracked)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Tracked so CI can seed the courses table (python -m app.ingestion.courses)
# without downloading the PDF. Regenerate and recommit it if clean.py changes.
!data/processed/academic_catalog_2024_2025.txt

